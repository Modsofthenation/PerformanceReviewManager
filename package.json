{
  "name": "performance-review-manager",
  "private": true,
  "version": "0.1.0-alpha.1",
  "license": "MIT",
  "description": "Local solo EM workbench for evidence-backed performance reviews",
  "scripts": {
    "dev": "pnpm --parallel --filter @prm/api --filter @prm/ui dev",
    "dev:api": "pnpm --filter @prm/api dev",
    "dev:ui": "pnpm --filter @prm/ui dev",
    "mcp": "pnpm --filter @prm/mcp start",
    "desktop:dev": "pnpm --filter @prm/desktop dev",
    "desktop:build": "pnpm --filter @prm/desktop build",
    "build": "pnpm -r build",
    "db:seed": "pnpm --filter @prm/api seed",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @prm/api test",
    "screenshots": "node scripts/capture-screenshots.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "devDependencies": {
    "puppeteer-core": "25.5.0"
  }
}
